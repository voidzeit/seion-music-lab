# SEION Music Lab environment configuration.
# Copy this file to ".env" and fill in values as needed.
# IMPORTANT: the MVP runs fully offline. None of the API keys below are
# required for deterministic music generation. They are only used once you
# wire up the optional LLM providers.

SEION_ENV=dev
SEION_DATA_DIR=./data
LOG_LEVEL=INFO

# --- Default LLM routing (optional, future use) ---
SEION_DEFAULT_PROVIDER=openrouter
SEION_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
SEION_LOCAL_MODEL=qwen3.6:27b

# --- Provider API keys (optional, never commit real keys) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- FL Studio integration (optional, future use) ---
# On Windows these usually live under your Documents folder.
FL_USER_DATA_DIR=C:\Users\YOUR_USER\Documents\Image-Line\FL Studio
FL_PIANO_ROLL_SCRIPTS_DIR=C:\Users\YOUR_USER\Documents\Image-Line\FL Studio\Settings\Piano roll scripts

# --- Storage (optional, JSON files are used for the MVP) ---
DATABASE_URL=sqlite:///./data/memory/seion_music.db
